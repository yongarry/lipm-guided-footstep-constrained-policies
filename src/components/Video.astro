---
import type { HTMLAttributes } from "astro/types";
interface Props extends HTMLAttributes<"video"> {
  src: string;
  /** `video` = 16:9, `portrait` = 9:16 */
  aspect?: "video" | "portrait";
}

const {
  src,
  aspect = "video",
  controls = true,
  loop = true,
  playsinline = true,
  muted = true,
  autoplay = true,
  ...videoProps
} = Astro.props;
---

<video
  class:list={[
    "h-auto rounded-lg",
    aspect === "portrait"
      ? "aspect-[9/16] mx-auto max-h-[min(70vh,40rem)] w-auto max-w-full"
      : "aspect-video w-full",
  ]}
  src={src}
  controls={controls}
  loop={loop}
  playsinline={playsinline}
  muted={muted}
  autoplay={autoplay}
  {...videoProps}></video>
